{
  "name": "cnc-fun",
  "version": "0.0.0",
  "repository": "git@github.com:TathagataChakraborti/cnc-fun.git",
  "bugs": "https://github.com/TathagataChakraborti/cnc-fun/issues",
  "license": "Apache 2.0",
  "scripts": {
    "format": "prettier --write \"**/*.{js,jsx,md,scss}\"",
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@carbon/charts-react": "^1.11.10",
    "@carbon/react": "^1.31.3",
    "@carbon/styles": "^1.33.1",
    "@stdlib/stats-kstest": "0.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "react": "^18.1.0",
    "react-dom": "^18.1.0",
    "react-github-btn": "^1.4.0",
    "react-router-dom": "^5.0.0",
    "sass": "^1.101.0",
    "vite": "^8.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^17.7.1",
    "@commitlint/config-conventional": "^7.5.0",
    "gh-pages": "^5.0.0",
    "husky": "^1.3.1",
    "lint-staged": "^14.0.0",
    "node-sass": "^9.0.0",
    "prettier": "^1.17.0"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ],
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "lint-staged": {
    "*.js": [
      "yarn format:staged",
      "git add"
    ],
    "*.{scss,css}": [
      "yarn format:staged",
      "git add"
    ],
    "*.md": [
      "yarn format:staged",
      "git add"
    ]
  },
  "prettier": {
    "jsxBracketSameLine": true,
    "printWidth": 80,
    "singleQuote": true,
    "trailingComma": "es5"
  }
}
